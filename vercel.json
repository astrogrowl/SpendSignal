{
  "cleanUrls": true,
  "trailingSlash": false,
  "builds": [
    { "src": "*.html",     "use": "@vercel/static" },
    { "src": "public/**",  "use": "@vercel/static" },
    { "src": "api/*.js",   "use": "@vercel/node"   }
  ],
  "routes": [
    { "src": "/quiz", "dest": "/quiz.html" },
    { "src": "/",     "dest": "/index.html" }
  ]
}
